<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nejmlabs.things-index-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_ME/.local/bin/things-index-worker</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>THINGS_INDEX_SERVER_URL</key>
        <string>REPLACE_WITH_SERVER_URL</string>
        <key>THINGS_INDEX_WORKER_TOKEN</key>
        <string>REPLACE_WITH_WORKER_TOKEN</string>
        <key>THINGS_INDEX_JOURNAL_PATH</key>
        <string>/Users/REPLACE_ME/Library/Application Support/ThingsIndex/journal.db</string>
        <key>THINGS_INDEX_HELPER_TEMP_DIR</key>
        <string>/Users/REPLACE_ME/Library/Application Support/ThingsIndex/HelperRequests</string>
        <key>THINGS_INDEX_JOURNAL_RETENTION_DAYS</key>
        <string>30</string>
    </dict>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/ThingsIndex/worker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/ThingsIndex/worker-error.log</string>
</dict>
</plist>
